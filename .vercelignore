# Python backend / scraper tooling — not deployed
*.py
__pycache__/
.venv/
requirements.txt
node_modules/
.vercel/
.git/
.DS_Store
test-results/
.tmp/

# Scraped data and images (large) — keep only the small catalogs the wholesale
# APIs read at runtime (api/_lib/wholesale-muay-thai.js, wholesale-supplements.js);
# everything else in data/ (multi-MB build sources / search indexes / checkout
# catalog) stays excluded to avoid the Vercel request body / bundle size limit.
output/
archive_original_project/
data/*.json
!data/checkout-catalog.json
!data/search-index.json
!data/wholesale-muay-thai-catalog.json
!data/wholesale-supplements-catalog.json
data/final/*.json
!data/final/catalog.published.json
!data/final/search-index.published.json
data/archive/
api/cart/validate 2.js
api/catalog/products 2.js

# Legacy card-checkout endpoints are kept in source history but are not part of
# the bank-transfer order flow deployed to production.
api/admin/
api/checkout.js
api/checkout-quote.js
api/checkout/quote.js
api/orders/index.js
api/newsletter.js

# Supabase CLI local dev files
supabase/
supabase/.temp/
supabase/.branches/

# Dev/tool scripts
scripts/
tools/
tests/
utils/
scrapers/
src/
docs/

# Secrets (belt-and-suspenders — also in .gitignore)
.env
.env.*
