# Server-only. Never expose these in HTML or browser JavaScript.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
STRIPE_SECRET_KEY=sk_live_your_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Public site origin used for Stripe success/cancel URLs.
ATHLETONIC_SITE_URL=https://athletonic.com

# Optional commerce settings.
STRIPE_API_VERSION=2026-02-25.clover
STRIPE_AUTOMATIC_TAX=false
STRIPE_ALLOW_PROMOTION_CODES=false
STRIPE_COLLECT_PHONE=false
STRIPE_SHIPPING_RATE_ID=
ATHLETONIC_SHIPPING_AMOUNT_CENTS=0
ATHLETONIC_FREE_SHIPPING_MIN_CENTS=0
ATHLETONIC_SHIPPING_COUNTRIES=US
