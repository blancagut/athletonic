{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/gym-builder",
      "destination": "/index.html"
    },
    {
      "source": "/gym-builder/",
      "destination": "/index.html"
    },
    {
      "source": "/gym-builder/:path*",
      "destination": "/:path*"
    }
  ]
}