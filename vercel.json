{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 10
    }
  },
  "redirects": [
    {
      "source": "/pages/footwear.html",
      "destination": "/pages/fight-clothing.html",
      "permanent": true
    },
    {
      "source": "/pages/wholesale-application.html",
      "destination": "/wholesale-application",
      "permanent": true
    },
    {
      "source": "/pages/wholesale-application",
      "destination": "/wholesale-application",
      "permanent": true
    },
    {
      "source": "/pages/pedido.html",
      "destination": "/order",
      "permanent": true
    },
    {
      "source": "/pages/pedido",
      "destination": "/order",
      "permanent": true
    },
    {
      "source": "/pages/international_orders.html",
      "destination": "/international_orders",
      "permanent": true
    },
    {
      "source": "/pages/international_orders",
      "destination": "/international_orders",
      "permanent": true
    },
    {
      "source": "/pedido",
      "destination": "/order",
      "permanent": true
    },
    {
      "source": "/pages/catalog/wholesale-muay-thai.html",
      "destination": "/catalog/wholesale-muay-thai",
      "permanent": true
    },
    {
      "source": "/pages/catalog/wholesale-muay-thai",
      "destination": "/catalog/wholesale-muay-thai",
      "permanent": true
    },
    {
      "source": "/pages/catalog/wholesale-supplements.html",
      "destination": "/catalog/wholesale-supplements",
      "permanent": true
    },
    {
      "source": "/pages/catalog/wholesale-supplements",
      "destination": "/catalog/wholesale-supplements",
      "permanent": true
    },
    {
      "source": "/pages/catalog/international_orders_martial_arts.html",
      "destination": "/catalog/international_orders_martial_arts",
      "permanent": true
    },
    {
      "source": "/pages/catalog/international_orders_martial_arts",
      "destination": "/catalog/international_orders_martial_arts",
      "permanent": true
    },
    {
      "source": "/pages/catalog/muaythai_mma.html",
      "destination": "/muaythai_mma",
      "permanent": true
    },
    {
      "source": "/pages/catalog/muaythai_mma",
      "destination": "/muaythai_mma",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/international_orders",
      "destination": "/pages/international_orders.html"
    },
    {
      "source": "/wholesale-application",
      "destination": "/pages/wholesale-application.html"
    },
    {
      "source": "/order",
      "destination": "/pages/pedido.html"
    },
    {
      "source": "/catalog/wholesale-muay-thai",
      "destination": "/pages/catalog/wholesale-muay-thai.html"
    },
    {
      "source": "/catalog/wholesale-supplements",
      "destination": "/pages/catalog/wholesale-supplements.html"
    },
    {
      "source": "/catalog/international_orders_martial_arts",
      "destination": "/pages/catalog/international_orders_martial_arts.html"
    },
    {
      "source": "/muaythai_mma",
      "destination": "/pages/catalog/muaythai_mma.html"
    },
    {
      "source": "/catalog/muaythai_mma",
      "destination": "/pages/catalog/muaythai_mma.html"
    },
    {
      "source": "/order-status",
      "destination": "/pages/order-status.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
